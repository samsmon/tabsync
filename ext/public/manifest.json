{
  "manifest_version": 3,
  "name": "TabSync",
  "version": "0.3.3",
  "description": "Collapse tabs into a list, synced end-to-end encrypted across your devices.",
  "action": {
    "default_title": "Send tabs to TabSync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "alarms",
    "contextMenus",
    "favicon",
    "tabGroups"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
